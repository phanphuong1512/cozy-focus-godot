func get_icon(icon_name: String, tint: Color = Color("#f7ebd9"), scale: int = 2) -> ImageTexture:
	var s := maxi(1, scale)
	var key := "mono|%s|%s|%d" % [icon_name, tint.to_html(true), s]
	if _cache.has(key):
		return _cache[key]

	if not MONO_ICONS.has(icon_name):
		if COLORED_ICONS.has(icon_name):
			return get_colored_icon(icon_name, s)
		return get_icon("sparkle", tint, s)

	var grid: Array = MONO_ICONS[icon_name]
	var img := Image.create(16 * s, 16 * s, false, Image.FORMAT_RGBA8)

	var light := tint.lightened(0.28)
	light.a = tint.a
	var dark := tint.darkened(0.32)
	dark.a = tint.a
	var outline := Color(OUTLINE_DARK.r, OUTLINE_DARK.g, OUTLINE_DARK.b, tint.a)

	for y in range(mini(16, grid.size())):
		var row := str(grid[y])
		for x in range(mini(16, row.length())):
			var ch := row[x]
			if ch == ".":
				continue
			var col: Color
			match ch:
				"#":
					col = tint
				"+":
					col = light
				"-":
					col = dark
				"o":
					col = outline
				_:
					continue
			_fill_scaled_px(img, x, y, s, col)

	var tex := ImageTexture.create_from_image(img)
	_cache[key] = tex
	return tex


func get_colored_icon(icon_name: String, scale: int = 2) -> ImageTexture:
	var s := maxi(1, scale)
	var key := "col|%s|%d" % [icon_name, s]
	if _cache.has(key):
		return _cache[key]

	if not COLORED_ICONS.has(icon_name):
		return get_icon(icon_name, Color("#f7ebd9"), s)

	var spec: Dictionary = COLORED_ICONS[icon_name]
	var pal: Dictionary = spec.get("palette", {})
	var grid: Array = spec.get("grid", [])
	var img := Image.create(16 * s, 16 * s, false, Image.FORMAT_RGBA8)

	var parsed_pal: Dictionary = {}
	for k in pal.keys():
		parsed_pal[str(k)] = Color.from_string(str(pal[k]), Color.WHITE)

	for y in range(mini(16, grid.size())):
		var row := str(grid[y])
		for x in range(mini(16, row.length())):
			var ch := row[x]
			if ch == "." or not parsed_pal.has(ch):
				continue
			_fill_scaled_px(img, x, y, s, parsed_pal[ch])

	var tex := ImageTexture.create_from_image(img)
	_cache[key] = tex
	return tex


func get_reaction_texture(raw_emote: String, scale: int = 2) -> ImageTexture:
	match raw_emote:
		"❤️":
			return get_colored_icon("react_heart", scale)
		"✨":
			return get_colored_icon("react_star", scale)
		"🔥":
			return get_colored_icon("react_fire", scale)
		"☕":
			return get_colored_icon("react_coffee", scale)
		"👏":
			return get_colored_icon("react_clap", scale)
		"💤":
			return get_colored_icon("react_zzz", scale)
		_:
			return get_colored_icon("react_heart", scale)


func _fill_scaled_px(img: Image, x: int, y: int, s: int, col: Color) -> void:
	if s == 1:
		img.set_pixel(x, y, col)
	else:
		img.fill_rect(Rect2i(x * s, y * s, s, s), col)
